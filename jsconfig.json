{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "checkJs": false,
        "allowJs": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@config/*": ["src/js/config/*"],
            "@modules/*": ["src/js/modules/*"],
            "@app": ["src/js/app.js"]
        }
    },
    "include": ["src/**/*.js", "test/**/*.js", "vite.config.js", "vitest.config.js"],
    "exclude": ["node_modules", "dist"]
}